{
  "version": 6,
  "configurePresets": [
    {
      "name": "local-vcpkg",
      "hidden": true,
      "environment": {
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "<path-to-vcpkg>/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_FEATURE_FLAGS": "manifests"
      }
    },
    {
      "name": "msvc2022-debug-local",
      "inherits": "local-vcpkg",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/msvc2022-debug"
    },
    {
      "name": "msvc2022-release-local",
      "inherits": "local-vcpkg",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/msvc2022-release"
    },
    {
      "name": "msvc2026-debug-local",
      "inherits": "local-vcpkg",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/msvc2026-debug"
    },
    {
      "name": "msvc2026-release-local",
      "inherits": "local-vcpkg",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/msvc2026-release"
    },
    {
      "name": "macos-arm64-debug-local",
      "inherits": "local-vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-release-local",
      "inherits": "local-vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-x64-debug-local",
      "inherits": "local-vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-x64-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-osx",
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-msvc2022-debug-local",
      "configurePreset": "msvc2022-debug-local",
      "configuration": "Debug"
    },
    {
      "name": "build-msvc2022-release-local",
      "configurePreset": "msvc2022-release-local",
      "configuration": "Release"
    },
    {
      "name": "build-msvc2026-debug-local",
      "configurePreset": "msvc2026-debug-local",
      "configuration": "Debug"
    },
    {
      "name": "build-msvc2026-release-local",
      "configurePreset": "msvc2026-release-local",
      "configuration": "Release"
    },
    {
      "name": "build-macos-arm64-debug-local",
      "configurePreset": "macos-arm64-debug-local"
    },
    {
      "name": "build-macos-arm64-release-local",
      "configurePreset": "macos-arm64-release-local"
    },
    {
      "name": "build-macos-x64-debug-local",
      "configurePreset": "macos-x64-debug-local"
    }
  ],
  "testPresets": [
    {
      "name": "test-msvc2022-debug-local",
      "configurePreset": "msvc2022-debug-local",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-msvc2022-release-local",
      "configurePreset": "msvc2022-release-local",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-msvc2026-debug-local",
      "configurePreset": "msvc2026-debug-local",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-msvc2026-release-local",
      "configurePreset": "msvc2026-release-local",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-macos-arm64-debug-local",
      "configurePreset": "macos-arm64-debug-local",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-macos-arm64-release-local",
      "configurePreset": "macos-arm64-release-local",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-macos-x64-debug-local",
      "configurePreset": "macos-x64-debug-local",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
