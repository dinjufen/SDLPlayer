{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "condition": {
        "type": "notEquals",
        "lhs": "$env{VCPKG_ROOT}",
        "rhs": ""
      },
      "environment": {
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_FEATURE_FLAGS": "manifests"
      }
    },
    {
      "name": "msvc2026-debug",
      "inherits": "vcpkg-base",
      "displayName": "MSVC 2026 Debug",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/msvc2026-debug"
    },
    {
      "name": "msvc2026-release",
      "inherits": "vcpkg-base",
      "displayName": "MSVC 2026 Release",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/msvc2026-release"
    },
    {
      "name": "msvc2022-debug",
      "inherits": "vcpkg-base",
      "displayName": "MSVC 2022 Debug",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/msvc2022-debug"
    },
    {
      "name": "msvc2022-release",
      "inherits": "vcpkg-base",
      "displayName": "MSVC 2022 Release",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/msvc2022-release"
    },
    {
      "name": "macos-arm64-debug",
      "inherits": "vcpkg-base",
      "displayName": "macOS arm64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-release",
      "inherits": "vcpkg-base",
      "displayName": "macOS arm64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-x64-debug",
      "inherits": "vcpkg-base",
      "displayName": "macOS x64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-x64-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-osx",
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "linux-ninja-debug",
      "inherits": "vcpkg-base",
      "displayName": "Linux Ninja (vcpkg) Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-ninja-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-system-debug",
      "displayName": "Linux Ninja (system packages) Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-system-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-qt-debug",
      "displayName": "macOS Qt 6.9 arm64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-qt-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_PREFIX_PATH": "/Users/ding/Qt/6.9.0/macos;/opt/homebrew",
        "SDLPLAYER_BUILD_QT": "ON",
        "SDLPLAYER_REQUIRE_QT": "ON",
        "SDLPLAYER_BUILD_SDL": "ON"
      },
      "environment": {
        "PKG_CONFIG_PATH": "/opt/homebrew/lib/pkgconfig:/opt/homebrew/opt/ffmpeg/lib/pkgconfig"
      }
    },
    {
      "name": "macos-qt-release",
      "displayName": "macOS Qt 6.9 arm64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-qt-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_PREFIX_PATH": "/Users/ding/Qt/6.9.0/macos;/opt/homebrew",
        "SDLPLAYER_BUILD_QT": "ON",
        "SDLPLAYER_REQUIRE_QT": "ON",
        "SDLPLAYER_BUILD_SDL": "ON"
      },
      "environment": {
        "PKG_CONFIG_PATH": "/opt/homebrew/lib/pkgconfig:/opt/homebrew/opt/ffmpeg/lib/pkgconfig"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-msvc2026-debug",
      "configurePreset": "msvc2026-debug",
      "configuration": "Debug"
    },
    {
      "name": "build-msvc2026-release",
      "configurePreset": "msvc2026-release",
      "configuration": "Release"
    },
    {
      "name": "build-msvc2022-debug",
      "configurePreset": "msvc2022-debug",
      "configuration": "Debug"
    },
    {
      "name": "build-msvc2022-release",
      "configurePreset": "msvc2022-release",
      "configuration": "Release"
    },
    {
      "name": "build-macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "build-macos-arm64-release",
      "configurePreset": "macos-arm64-release"
    },
    {
      "name": "build-macos-x64-debug",
      "configurePreset": "macos-x64-debug"
    },
    {
      "name": "build-linux-ninja-debug",
      "configurePreset": "linux-ninja-debug"
    },
    {
      "name": "build-linux-system-debug",
      "configurePreset": "linux-system-debug"
    },
    {
      "name": "build-macos-qt-debug",
      "configurePreset": "macos-qt-debug"
    },
    {
      "name": "build-macos-qt-release",
      "configurePreset": "macos-qt-release"
    }
  ],
  "testPresets": [
    {
      "name": "test-msvc2026-debug",
      "configurePreset": "msvc2026-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-msvc2026-release",
      "configurePreset": "msvc2026-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-msvc2022-debug",
      "configurePreset": "msvc2022-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-msvc2022-release",
      "configurePreset": "msvc2022-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-macos-x64-debug",
      "configurePreset": "macos-x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-linux-ninja-debug",
      "configurePreset": "linux-ninja-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-linux-system-debug",
      "configurePreset": "linux-system-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-macos-qt-debug",
      "configurePreset": "macos-qt-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-macos-qt-release",
      "configurePreset": "macos-qt-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
